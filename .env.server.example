# ==============================================================================
# FollowUpAI Server Environment Configuration
# ==============================================================================
# IMPORTANT:
# Keep this file server-side only. Do NOT use VITE_ prefix.
# Never expose GEMINI_API_KEY to frontend code or client bundles.

# Google Gemini API Key (Server-only)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 3001)
PORT=3001

# Firebase Project ID (for Firebase Admin SDK token verification)
FIREBASE_PROJECT_ID=followupai-73abb

# Optional: Path to Firebase Service Account JSON (if needed for local offline admin)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
